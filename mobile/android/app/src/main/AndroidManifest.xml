<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- allowBackup is off: the web view keeps the person's profile, applications and resume details on the phone, and Android's
         automatic backup would copy them to their Google account without them choosing it. The profile and swipes live only on
         the phone, even with an account: Profile > Data & privacy > Download backup is how a person keeps a copy.
         Android 12+ still copies app data in a phone-to-phone transfer the person starts themselves. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- assisted apply: an employer's own application page, filled from the profile, the person taps Submit (docs/assisted-apply.md) -->
        <activity
            android:name=".AssistActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:theme="@style/AppTheme.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Jobs near you (on dev, the site the apps open; shared/uaply-nav.js): the page asks through the web view (navigator.geolocation) and Capacitor's
         web view turns that into this app's own location prompt. It asks for both at once and accepts "Approximate" on Android 12+;
         the page rounds the position to about a mile, keeps it on the phone and never sends it to the server. Never in the background. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- interview reminders (@capacitor/local-notifications): Android 13+ shows no notification without it. The plugin's own manifest
         merges it in too; it is listed here so the permission is visible and checked (tools/test-mobile-perms.py). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
